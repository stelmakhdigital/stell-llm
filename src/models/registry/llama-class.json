{
  "schema": "1.0",
  "name": "llama-class",
  "class": "dense",
  "dtype_weights": "F16",
  "vocab_size": 32000,
  "d_model": 4096,
  "n_layers": 32,
  "n_heads": 32,
  "d_head": 128,
  "kv": {
    "dtype": "F16",
    "n_kv_heads": 32,
    "d_kv": 128,
    "quant": null
  },
  "ops": [
    {
      "op": "rmsnorm",
      "io": ["hidden"],
      "params": { "eps": 1e-5 }
    },
    {
      "op": "attention",
      "io": ["hidden", "kv"],
      "params": { "kernel": "sm70_fp32_qk_pv" }
    },
    {
      "op": "ffn",
      "io": ["hidden"],
      "params": { "activation": "silu_mul" }
    }
  ],
  "tensor_groups": [
    {
      "name": "embed",
      "role": "attn",
      "shape": [32000, 4096],
      "dtype": "F16",
      "source_pattern": "embedding.weight"
    },
    {
      "name": "norm_final",
      "role": "attn",
      "shape": [4096],
      "dtype": "F32",
      "source_pattern": "model.norm.weight"
    },
    {
      "name": "head",
      "role": "attn",
      "shape": [32000, 4096],
      "dtype": "F16",
      "source_pattern": "head.weight"
    },
    {
      "name": "l{layer}.attn.norm",
      "role": "attn",
      "shape": [4096],
      "dtype": "F32",
      "source_pattern": "layers.{layer}.input_layernorm.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.attn.wq",
      "role": "attn",
      "shape": [4096, 4096],
      "dtype": "F16",
      "source_pattern": "layers.{layer}.self_attn.q_proj.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.attn.wk",
      "role": "attn",
      "shape": [4096, 4096],
      "dtype": "F16",
      "source_pattern": "layers.{layer}.self_attn.k_proj.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.attn.wv",
      "role": "attn",
      "shape": [4096, 4096],
      "dtype": "F16",
      "source_pattern": "layers.{layer}.self_attn.v_proj.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.attn.wo",
      "role": "attn",
      "shape": [4096, 4096],
      "dtype": "F16",
      "source_pattern": "layers.{layer}.self_attn.o_proj.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.ffn.norm",
      "role": "attn",
      "shape": [4096],
      "dtype": "F32",
      "source_pattern": "layers.{layer}.post_layernorm.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.ffn.up",
      "role": "attn",
      "shape": [16384, 4096],
      "dtype": "F16",
      "source_pattern": "layers.{layer}.mlp.up_proj.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.ffn.gate",
      "role": "attn",
      "shape": [16384, 4096],
      "dtype": "F16",
      "source_pattern": "layers.{layer}.mlp.gate_proj.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.ffn.down",
      "role": "attn",
      "shape": [4096, 16384],
      "dtype": "F16",
      "source_pattern": "layers.{layer}.mlp.down_proj.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.kv",
      "role": "kv",
      "shape": [4096, 4096],
      "dtype": "F16",
      "source_pattern": "layers.{layer}.kv_cache",
      "kv_block": true,
      "cardinality": { "layer": 32 }
    }
  ]
}
