{
  "schema": "1.0",
  "name": "glm-class",
  "class": "moe",
  "dtype_weights": "NVFP4",
  "vocab_size": 131072,
  "d_model": 4096,
  "n_layers": 32,
  "n_heads": 64,
  "d_head": 128,
  "kv": {
    "dtype": "F16",
    "n_kv_heads": 8,
    "d_kv": 128,
    "quant": null
  },
  "moe": {
    "n_experts": 128,
    "n_experts_active": 8,
    "expert_d_ff": 1024,
    "router": "softmax-topk"
  },
  "ops": [
    {
      "op": "rmsnorm",
      "io": ["hidden"],
      "params": { "eps": 1e-5 }
    },
    {
      "op": "attention",
      "io": ["hidden", "kv"],
      "params": { "kernel": "sm70_fp32_qk_pv" }
    },
    {
      "op": "moe_gather_scatter",
      "io": ["hidden", "experts"],
      "params": { "kernel": "sm70_moe_gs" }
    }
  ],
  "tensor_groups": [
    {
      "name": "embed",
      "role": "attn",
      "shape": [131072, 4096],
      "dtype": "F16",
      "source_pattern": "embedding.weight"
    },
    {
      "name": "norm_final",
      "role": "attn",
      "shape": [4096],
      "dtype": "F32",
      "source_pattern": "model.norm.weight"
    },
    {
      "name": "l{layer}.attn.norm",
      "role": "attn",
      "shape": [4096],
      "dtype": "F32",
      "source_pattern": "layers.{layer}.input_layernorm.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.attn.wq",
      "role": "attn",
      "shape": [4096, 4096],
      "dtype": "NVFP4",
      "source_pattern": "layers.{layer}.self_attn.q_proj.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.attn.wk",
      "role": "attn",
      "shape": [1024, 4096],
      "dtype": "NVFP4",
      "source_pattern": "layers.{layer}.self_attn.k_proj.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.attn.wv",
      "role": "attn",
      "shape": [1024, 4096],
      "dtype": "NVFP4",
      "source_pattern": "layers.{layer}.self_attn.v_proj.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.attn.wo",
      "role": "attn",
      "shape": [4096, 4096],
      "dtype": "NVFP4",
      "source_pattern": "layers.{layer}.self_attn.o_proj.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.kv",
      "role": "kv",
      "shape": [1024, 4096],
      "dtype": "F16",
      "source_pattern": "layers.{layer}.kv_cache",
      "kv_block": true,
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.mlp.norm",
      "role": "attn",
      "shape": [4096],
      "dtype": "F32",
      "source_pattern": "layers.{layer}.mlp.norm.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.mlp.router",
      "role": "expert",
      "shape": [128],
      "dtype": "F32",
      "source_pattern": "layers.{layer}.mlp.router.weight",
      "cardinality": { "layer": 32 }
    },
    {
      "name": "l{layer}.e{expert}.gate_up",
      "role": "expert",
      "shape": [2048, 4096],
      "dtype": "NVFP4",
      "source_pattern": "layers.{layer}.mlp.experts.{expert}.gate_up.weight",
      "cardinality": { "layer": 32, "expert": 128 }
    },
    {
      "name": "l{layer}.e{expert}.down",
      "role": "expert",
      "shape": [4096, 1024],
      "dtype": "NVFP4",
      "source_pattern": "layers.{layer}.mlp.experts.{expert}.down.weight",
      "cardinality": { "layer": 32, "expert": 128 }
    }
  ]
}
